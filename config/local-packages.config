# 本地自定义软件包 / 精简项（由 diy-part3.sh 追加到 .config 末尾）
# 目的：与上游 config/zn-m2.config 保持零差异，避免每次合并上游都冲突。
#
# 本文件有两种用法（kconfig 中后出现的赋值覆盖前面的）：
#   新增：CONFIG_PACKAGE_xxx=y
#   删除：把 CONFIG_PACKAGE_xxx=y 改写成 "# CONFIG_PACKAGE_xxx is not set"
#
# 四条注意事项：
#   1. 删除只对叶子包有效。被其他包 select 的（如 ipset、kmod-tun，
#      以及 coreutils 系列被 luci-app-passwall 依赖）写了也会被拉回来。
#   2. 写之前先确认上游确实选了它：
#        grep -n "CONFIG_PACKAGE_xxx" config/zn-m2.config
#      上游 config 未声明的包分两种：本来就不进固件的（写了无效），
#      以及由源码默认包集带入的（default y 或被依赖），写 is not set 可能生效，
#      但需构建后看 manifest 验证，如 qca-ssdk-shell。
#   3. 本文件不参与本地编译，只在 CI 的 diy-part3.sh 阶段被 cat 进 .config，
#      所以改完必须重新构建才生效。
#   4. 想验证某包最终是否进固件，看 Release 里的 *.manifest 文件。

# ============================================================
# 一、新增：ZeroTier 内网穿透
# ============================================================
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# ============================================================
# 二、精简原则
#
# 只删除与 passwall、zerotier 无关的软件。
# passwall 相关一律保留，包括三个协议内核与全部可选后端：
#   Xray / Sing-box / Hysteria（Hysteria2 独立内核）
#   v2ray-geosite + v2ray-geoip 分流数据、xray-plugin
#   haproxy、smartdns、geoview、pdnsd-alt、dns2tcp、ssocks、simple-obfs
# 理由：Sing-box 支持 TUIC / AnyTLS / SSH / Snell 等 Xray 没有的协议，
#       保留它可覆盖更多订阅节点类型，不按"当前是 VLESS + HY2"裁剪。
# ============================================================

# --- 三、大体积应用（Go 程序，合计约 -9MB）---

# lucky：端口转发 / DDNS / 内网穿透（穿透已由 ZeroTier 承担）
# CONFIG_PACKAGE_lucky is not set
# CONFIG_PACKAGE_luci-app-lucky is not set
# CONFIG_PACKAGE_luci-i18n-lucky-zh-cn is not set

# nps/npc：内网穿透服务端与客户端
# CONFIG_PACKAGE_luci-app-nps is not set
# CONFIG_PACKAGE_luci-i18n-nps-zh-cn is not set

# 集客 AC 控制器（无集客 AP）
# CONFIG_PACKAGE_gecoosac is not set
# CONFIG_PACKAGE_luci-app-gecoosac is not set

# --- 四、Web 服务类（对外 HTTP 端口，SSH 已够用）---

# ttyd 网页终端
# CONFIG_PACKAGE_ttyd is not set
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn is not set

# 注：luci-app-filetransfer 原计划删除，实测仅约 10KB，
# 而 LuCI 内直接上传文件到任意目录比开 scp 方便，故保留。

# --- 五、VPN 服务端（远程组网已由 ZeroTier 承担）---

# OpenVPN
# CONFIG_PACKAGE_openvpn-openssl is not set
# CONFIG_PACKAGE_openvpn-easy-rsa is not set
# CONFIG_PACKAGE_luci-app-openvpn is not set
# CONFIG_PACKAGE_liblzo is not set

# WireGuard（含内核模块；passwall 的 WireGuard 出站是用户态实现，不依赖它）
# CONFIG_PACKAGE_kmod-wireguard is not set
# CONFIG_PACKAGE_wireguard-tools is not set
# CONFIG_PACKAGE_luci-app-wireguard is not set
# CONFIG_PACKAGE_luci-proto-wireguard is not set
# CONFIG_PACKAGE_luci-i18n-wireguard-zh-cn is not set

# --- 六、其他无关网络功能 ---

# DDNS 动态域名（内网无公网域名解析需求）
# CONFIG_PACKAGE_ddns-scripts is not set
# CONFIG_PACKAGE_ddns-scripts_aliyun is not set
# CONFIG_PACKAGE_ddns-scripts_dnspod is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-i18n-ddns-zh-cn is not set

# UPnP 端口映射（无 BT / 游戏主机需求）
# CONFIG_PACKAGE_miniupnpd is not set
# CONFIG_PACKAGE_libminiupnpc is not set
# CONFIG_PACKAGE_libnatpmp is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-i18n-upnp-zh-cn is not set

# 注：wol / etherwake / luci-app-wol 原计划删除，合计不足 50KB，
# 而 ZeroTier 组网后手机在外连回家、再用 WOL 唤醒 NAS/PC 是典型场景，故保留。

# 链路聚合（需交换机支持 LACP）
# CONFIG_PACKAGE_proto-bonding is not set
# CONFIG_PACKAGE_luci-proto-bonding is not set
# CONFIG_PACKAGE_luci-i18n-bonding-zh-cn is not set

# --- 七、界面主题 ---

# 双主题只保留 design（diy-part3.sh 会改 design 的导航栏代理入口）
# argon 是备用外观，需要时从软件源装回即可，约 150~300KB
# CONFIG_PACKAGE_luci-theme-argon is not set

# 注：luci-app-arpbind、luci-app-autoreboot 原计划删除，实测合计不足 55KB，
# 而定时重启是长期挂机（passwall + zerotier）的实用兜底，故保留。

# --- 八、性能测试工具 ---

# CONFIG_PACKAGE_coremark is not set
# CONFIG_PACKAGE_stress-ng is not set
# CONFIG_PACKAGE_gn is not set

# --- 九、低频运维工具（需要时 opkg install 装回）---

# openssl 命令行：仅用于手动生成自签证书 / s_client 调试 TLS，
# passwall 与 zerotier 用的是 libopenssl 库，不依赖该命令
# CONFIG_PACKAGE_openssl-util is not set

# wget：busybox 版不支持 https，但 curl 是 passwall 硬依赖必定存在，可替代
# CONFIG_PACKAGE_wget-ssl is not set

# 高通 SSDK 调试 shell（ssdk_sh），查交换芯片与 PHY 协商状态用，
# 网口排查基本可由 swconfig 覆盖。注意：上游 config 未显式选中，
# 该包来自源码默认包集，此行是否生效需构建后看 manifest 确认
# CONFIG_PACKAGE_qca-ssdk-shell is not set
